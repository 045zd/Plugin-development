{
  "manifest_version": 3,
  "name": "学习通截止提醒",
  "short_name": "学习通提醒",
  "version": "1.2.25",
  "description": "监控学习通网页版课程作业与考试的截止时间，临近时用浏览器通知和邮件提醒你；支持登录页账号自动填充（不保存密码）。仅提醒，不自动答题。",
  "minimum_chrome_version": "126",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.chaoxing.com/*",
    "http://*.chaoxing.com/*",
    "https://*.cldisk.com/*",
    "http://*.cldisk.com/*",
    "https://*.ananas.chaoxing.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "学习通截止提醒",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://passport2.chaoxing.com/*"
      ],
      "js": [
        "content/login-autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
